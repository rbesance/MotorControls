#AUTO;MT-2,-2.5;CE 0,0;YA100,100;YB200,200;YC8000,8000;BW0,16;CN 1,1;ROTVEL=20
ANGLE=90;STARTZ=100;ENDZ=300;ZVEL=10;ACDCZ=15000;ACDCTBL=1000;trigDEG=90
trigEN=0;numE=800;idx=0;i=0;trigHel=1;pWDTH=100;clrCNT=1;a1Stat=0;a2Stat=0
pwTRIG=10;CO 1;SB18;SHA;SHB;JP#HOME;EN
#LOOP;speedA=(ROTVEL*5000);degA=(ANGLE*5000);doneB=0;startB=(STARTZ*-3937)
endB=(ENDZ*-3937);velZ=(ZVEL*3937);accelB=(ACDCZ*3937);accelA=(ACDCTBL*5000)
CB 2,_BGB=0;doneB=1;EN
#JOGZ;JS#LOOP;JGB=velZ;BGB;EN
#STOPZ;STB;MCB;EN
#HOME;JS#LOOP;SPA=speedA;SPB=velZ;HV10000,5000;HM;BG;MC;SP10000,5000;FI;BG;MC
WT100;DP0,0;DE0,0;EN;Runwhenlimitswitchesareactivated
#LIMSWI;IF(_LFB=0)|(_LRB=0);MG"Z LIMIT SWITCH";DCB=67000000;STB;AMB;ENDIF;RE
#ROTTBL;JS#LOOP;ACA=accelA;DCA=accelA;JGA=speedA;IF(trigEN=1);JS#INITTRG;ENDIF
BGA;IF(trigEN=1);XQ#TRIGANG,2;ENDIF;EN
#STOPTBL;STA;MCA;EN
#ROSHTBL;JS#LOOP;ACA=accelA;DCA=accelA;ACB=accelB;DCB=accelB;SPA=0;PAA=degA;BGA
IF(trigEN=1);JS#INITTRG;ENDIF;IF(trigEN=1);XQ#TRIGANG,2;ENDIF;SPA=speedA
JS#GOTOZE;WT1000;EN
#GOTOZB;JS#LOOP;ACB=accelB;DCB=accelB;SPB=velZ;PAB=startB;BGB;EN
#GOTOZE;SPB=velZ;PAB=endB;BGB;EN
#INITTRG;DA*[0];DMtrigLOG1[3500];DMtimeLOG1[3500];DMzPOS1[3500]
DMtrigLOG2[3500];DMtimeLOG2[3500];DMzPOS2[3500];a1Stat=0;a2Stat=0;idx=0
JS#CLRARY1;JS#CLRARY2;trigCNT=trigDEG*5000;EN
#TRIGANG;IF(idx>(3499));IF(idx=3500);a1Stat=2;ENDIF;a2Stat=1;temp=(idx-3500)
ARA=trigCNT;trigLOG2[temp]=(_TPA/2000);zPOS2[temp]=(_TPB/1575)
timeLOG2[temp]=TIME;CB 18;WT4;SB18;MG"Triggered at "trigLOG2[(idx-3500)]
idx=idx+1;IF(idx>(7000-1));a2Stat=2;idx=0;ENDIF;ENDIF;IF(idx<=3499);a1Stat=1
ARA=trigCNT;trigLOG1[idx]=(_TPA/2000);zPOS1[idx]=(_TPB/1575);timeLOG1[idx]=TIME
MG"Trigger ";MGidx;MG" ";MGtrigLOG1[idx];CB 18;WT4;SB18;idx=(idx+1);ENDIF
JP#TRIGANG,(_BGA=1);idx=0;EN
#ABSANG;JS#LOOP;ACA=accelA;DCA=accelA;SPA=speedA;PAA=degA;IF(trigEN=1)
JS#INITTRG;ENDIF;BGA;IF(trigEN=1);XQ#TRIGANG,2;ENDIF;EN
#CLRARY1;IF(i<trigLOG1[-1]);timeLOG1[i]=0;trigLOG1[i]=0;zPOS1[i]=0;i=i+1
JP#CLRARY1;ENDIF;i=0;EN
#CLRARY2;IF(i<trigLOG2[-1]);timeLOG2[i]=0;trigLOG2[i]=0;zPOS2[i]=0;i=i+1
JP#CLRARY2;ENDIF;i=0;EN
#pWAKE;i2=0
#wLOOP;CB 18;WTpWDTH;SB18;WT100;i2=i2+1;IF(i2<clrCNT);JP#wLOOP;ENDIF;EN
#tNUM;CB 18;WTpWDTH,1;SB18;WT(pwTRIG-pWDTH),1;nTRIG=nTRIG-1;JP#tNUM,(nTRIG>=1)
EN
#tINF;CB 18;WTpWDTH,1;SB18;WT(pwTRIG-pWDTH),1;JP#tINF,(nTRIG>=1);EN
#AngHome;JS#LOOP;IF((@ABS[_RPA])<1800000);tmp=@ABS[_RPA];ELSE
tmp=((@ABS[_RPA])%1800000);ENDIF;IF(_RPA<0);hmDist=tmp;ENDIF;IF(_RPA>0)
hmDist=(tmp*-1);ENDIF;IF(_RPA=0);hmDist=0;ENDIF;PRA=hmDist;BGA;MCA;DP0;DE0;EN